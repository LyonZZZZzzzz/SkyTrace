{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SkyTrace: macOS Debug",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/Build/Products/Debug/SkyTrace.app/Contents/MacOS/SkyTrace",
      "preLaunchTask": "SkyTrace: Build macOS"
    },
    {
      "name": "SkyTrace: iOS Simulator",
      "type": "sweetpad-lldb",
      "request": "launch",
      "project": "SkyTrace.xcodeproj",
      "scheme": "SkyTrace",
      "target": "SkyTrace",
      "configuration": "Debug",
      "destination": "platform=iOS Simulator,name=iPhone 16 Pro,OS=18.6",
      "preLaunchTask": "SkyTrace: Build iOS Simulator"
    }
  ]
}
